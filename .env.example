# Which LLM provider to use: "groq" (free tier, default) or "anthropic"
LLM_PROVIDER=groq

# Free API key from https://console.groq.com - no card required
GROQ_API_KEY=your_groq_key_here

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Model used for all agents. Good free Groq default: llama-3.3-70b-versatile
# If using Anthropic instead, try: claude-sonnet-4-6
CREW_MODEL=openai/gpt-oss-120b

# Max number of writer<->critic revision cycles before giving up
MAX_REVISIONS=2
